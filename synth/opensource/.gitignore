# everything below is regenerated by pnr/ppa.sh + map_*.ys.
*.log
*.txt
*.def
nangate45.lib
cpu.v
tage.v
types_sv2v.sv
netlist*.v
arb_*.v
*_net.v
src/
work/
# keep: dw_div_seq_bb.v, sram_bb.v, sta.tcl, map_docker.ys, map_core.ys,
#       and the whole pnr/ flow (filtered by pnr/.gitignore)
*.err
diag*
