# P&R-specific mapping: same as map_docker.ys but the cache SRAMs are wrapped
# around real fakeram45 macros (instead of empty blackboxes) so the netlist can
# be floorplanned/placed in OpenROAD. Writes pnr/netlist_pnr.v; leaves the
# area-baseline netlist.v untouched.
read_verilog -lib synth/opensource/pnr/fakeram_stubs.v
read_verilog -sv  synth/opensource/pnr/macro_wrappers.v
read_verilog -lib synth/opensource/dw_div_seq_bb.v
read_verilog synth/opensource/cpu.v
hierarchy -top cpu
# NOTE: no -flatten (keeps the fast per-module abc path; flatten makes abc grind the
# giant uBTB mux trees globally). OpenROAD flattens at DB-build time anyway.
synth -top cpu
# Drop the verification-only RVFI debug cone -- HIERARCHICAL prune (no flatten).
# rvfi_flat is a retirement-trace output (drives the riscv-formal monitor in sim,
# dangling in synthesis) that threads cpu <- backend_top_spinal <- rob_spinal.
# Deleting the port at each level + opt_clean removes the ~20k-flop rvfiArr debug
# state a real chip would not tape out, giving the TRUE functional-core area/power.
# pc_rdata survives (it also feeds backend_redirect_pc for violation recovery).
delete cpu/w:rvfi_flat
delete backend_top_spinal/w:rvfi_itf_flat
delete rob_spinal/w:rvfi_itf_flat
opt_clean -purge
# Use the Nangate45 liberty shipped in the OpenROAD docker (this runs in that
# image) so no multi-MB .lib needs to live in the repo.
dfflibmap -liberty /OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib
abc -liberty /OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib -fast
opt_clean -purge
write_verilog -noattr synth/opensource/pnr/netlist_pnr.v
tee -o synth/opensource/pnr/reports_area_pnr.txt stat -liberty /OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib -top cpu
